# =====================================================================
#  CookingAura · configuración (plantilla con valores de ejemplo)
#
#  1. Cópiala:   Copy-Item .env.example .env      (Linux/macOS: cp .env.example .env)
#  2. Cambia los valores marcados con ⚠️ por los tuyos.
#  3. El .env real NUNCA se sube a Git (está en .gitignore).
#
#  Los valores por defecto están pensados para un equipo SIN GPU con unos 8 GB para Docker.
# =====================================================================

# --- Python / logs ------------------------------------------------------
# Los mensajes del backend aparecen al momento en "docker logs"
PYTHONUNBUFFERED=1

# --- Direcciones entre contenedores (nombres de servicio del compose) ---
# Solo hay que cambiarlas si ejecutas algún servicio fuera de Docker (usa localhost)
MILVUS_HOST=standalone
OLLAMA_URL=http://ollama-server:11434
VLLM_URL=http://vllm-server:8000/v1
BACKEND_URL=http://cookingaura-app-backend:8080
# Usada por el servidor MCP para buscar en las recetas (mismo contenedor que el backend)
BACKEND_INTERNO_URL=http://localhost:8080

# --- Modelos de Ollama ---------------------------------------------------
# Un solo modelo para todo ahorra memoria y evita recargas.
# El del agente DEBE admitir herramientas (qwen2.5, qwen3, llama3.1...; llama3 no).
OLLAMA_MODELO_EVALUADOR=qwen2.5:3b
OLLAMA_MODELO_GENERADOR=qwen2.5:3b
AGENTE_MODELO=qwen2.5:3b

# --- Servidor Ollama (contenedor ollama-server) -------------------------
# -1 = no descargar nunca los modelos de memoria
OLLAMA_KEEP_ALIVE=-1
# Modelos cargados a la vez (1 si usas el mismo modelo para todo)
OLLAMA_MAX_LOADED_MODELS=1
# Peticiones simultáneas por modelo (cada una reserva memoria de contexto)
OLLAMA_NUM_PARALLEL=1

# --- Agente del chat libre ------------------------------------------------
# Rondas máximas de herramientas por mensaje
AGENTE_MAX_PASOS=5
# Mensajes anteriores del chat que recibe el agente
AGENTE_HISTORIAL=8
# Segundos máximos de espera a cada respuesta del modelo del agente
AGENTE_TIMEOUT=180

# --- Arranque -------------------------------------------------------------
# Cargar los modelos de Ollama al arrancar el backend: si | no
PRECALENTAR_MODELOS=si
# Cargar el modelo de embeddings (bge-m3, ~2 GB de RAM) al arrancar: si | no
PRECARGAR_EMBEDDINGS=si

# --- Voz (Whisper) --------------------------------------------------------
# tiny | base | small | medium · "small" entiende bien el español sin disparar la memoria
WHISPER_MODELO=small
# Haz de búsqueda al decodificar: más alto = algo más preciso y más lento
WHISPER_BEAM=5

# --- vLLM (solo con GPU NVIDIA y el perfil vllm-activo) -----------------
VLLM_MODELO=Qwen/Qwen2.5-7B-Instruct
# Fracción de la memoria de la GPU para vLLM
VLLM_GPU_UTIL=0.6
VLLM_MAX_MODEL_LEN=8192

# --- Ideas de platos --------------------------------------------------------
# Ideas por respuesta
IDEAS_TOTAL=5
# En modo automático, máximo de ideas sacadas de tus recetas (el resto, creativas)
IDEAS_MAX_LOCALES=3
# Motor de las ideas creativas: ollama (local) | gemini (Vertex AI, más rápido en CPU)
IDEAS_MOTOR=ollama
# Ingredientes de la despensa al pedir ideas sin indicarlos (principales y adecuados al tipo de comida)
DESPENSA_MAX_INGREDIENTES=20
# Ingredientes en común mínimos para proponer una receta propia como idea
EVAL_MIN_COINCIDENCIAS=2

# --- Generador de recetas --------------------------------------------------
# Caracteres máximos de la receta de referencia que recibe el generador
GENERADOR_MAX_CHARS=2000

# --- Búsqueda RAG en tus recetas -----------------------------------------
# hibrida | semantica | lexica  (elige la mejor con: python -m metricas.evaluar recall)
RAG_MODO=hibrida
# rrf | ponderado
RAG_RANKER=rrf
# Peso de la búsqueda semántica en la fusión ponderada (0 = solo BM25, 1 = solo semántica)
RAG_PESO_DENSO=0.7
RAG_TOP_K=3
RAG_RRF_K=60

# --- Modelos de HuggingFace (bge-m3, Whisper) ----------------------------
HF_HOME=/root/.cache/huggingface

# --- Google Cloud: búsqueda web e ideas con Gemini (Vertex AI) ----------
# ⚠️ El ID de tu proyecto de Google Cloud
GCP_PROJECT_ID=mi-proyecto-gcp-123456
# Ruta DENTRO del contenedor; la clave va en config/gcp-key.json (no se sube a Git)
GOOGLE_APPLICATION_CREDENTIALS=/app/config/gcp-key.json

# --- LangSmith (opcional: trazas de cada llamada a LLM) ------------------
LANGCHAIN_TRACING_V2=false
# ⚠️ Solo si activas las trazas
LANGSMITH_API_KEY=lsv2_pt_00000000000000000000000000000000_0000000000
LANGSMITH_PROJECT=cookingaura
# Cuentas de la región EU: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com